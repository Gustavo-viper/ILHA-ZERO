; Ilha Zero — battle royale tático em Godot 4.3+
; Abra esta pasta no Godot 4.3 (ou mais novo) e aperte F5.

config_version=5

[application]

config/name="Ilha Zero"
config/description="Battle royale tático de mundo aberto"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
